# Copie este arquivo para backend/.env e preencha os valores.
# NUNCA faça commit do .env real (já está no .gitignore).
# Equivalente ao antigo .streamlit/secrets.toml.example — ver backend/app/core/config.py.

# --- Login por e-mail/senha (obrigatório) ---
# Chave usada para assinar o JWT de sessão.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
jwt_secret_key=GERE_UMA_STRING_ALEATORIA_AQUI

# --- Chave de criptografia das credenciais do Earth Engine (obrigatório) ---
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde essa chave em local seguro: sem ela, as credenciais salvas no banco não podem
# ser descriptografadas.
app_encryption_key=GERE_UMA_CHAVE_FERNET_AQUI

# --- CORS: origens do frontend autorizadas a chamar a API ---
# Em produção atrás do Caddy, geralmente é só o próprio domínio (mesma origem,
# já que o Caddy serve o mesmo app), mas mantenha como lista JSON.
cors_origins=["https://seu-dominio.exemplo.com"]

# --- Cookie de refresh token: exige HTTPS (true) em produção atrás do Caddy ---
cookie_secure=true

# --- Caminho do banco SQLite (relativo à raiz do repositório) ---
db_path=data/app.db

# --- Login com Google (opcional) ---
# Só é necessário se você também quiser o botão "Entrar com Google". Deixe em
# branco/remova estas linhas se não for usar.
# google_client_id=SEU_CLIENT_ID.apps.googleusercontent.com
# google_client_secret=SEU_CLIENT_SECRET
# google_redirect_uri=https://seu-dominio.exemplo.com/oauth2callback
