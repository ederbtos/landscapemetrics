{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "none",
    "moduleResolution": "node10",
    "outFile": "./static/app.js",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["leaflet"]
  },
  "include": ["frontend-src/**/*.ts"]
}
